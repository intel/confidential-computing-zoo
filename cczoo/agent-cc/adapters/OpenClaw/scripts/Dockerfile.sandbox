# Dockerfile.sandbox — OpenClaw sandbox execution container
#
# This is the container that the OpenClaw gateway spawns as a sibling for
# each sandboxed tool/skill execution.  It is based on the upstream
# openclaw/openclaw scripts/docker/sandbox/Dockerfile.
#
# The default image includes python3 for sandbox write/edit helpers.
# OpenClaw will not substitute plain debian:bookworm-slim.
#
# Build:
#   docker build -f Dockerfile.sandbox -t openclaw-sandbox:bookworm-slim .
#
# Or run setup-sbx.sh which builds this automatically.

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    python3 \
    ripgrep

RUN useradd --create-home --shell /bin/bash sandbox
USER sandbox
WORKDIR /home/sandbox

CMD ["sleep", "infinity"]
