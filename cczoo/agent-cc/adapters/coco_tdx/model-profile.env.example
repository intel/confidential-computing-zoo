# Provider profile for an OpenAI-compatible chat API.
# Copy this file to a local, untracked path and edit the values.
# Never put an API key in this file.

MODEL_API_ADDRESS=https://openrouter.ai/api/v1
MODEL_NAME=minimax/minimax-m3:free
MODEL_API_KEY_SECRET=nano-bot-api-key
MODEL_API_KEY_SECRET_KEY=OPENAI_API_KEY

# Set a guest-resolvable proxy, or leave empty for direct access.
MODEL_PROXY_URL=
MODEL_NO_PROXY=127.0.0.1,localhost,10.244.0.0/16,10.96.0.0/12

# Use "none" only when a controlled TLS-intercepting proxy requires it.
MODEL_TLS_VERIFY=none
